    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        { "name": "Juan Tamayo", "homepage": "https://designstudionetwork.com" },
        { "name": "DesignStudio Network", "homepage": "https://designstudionetwork.com" }
